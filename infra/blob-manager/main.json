{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "4335489635669313603"
    }
  },
  "parameters": {
    "appName": {
      "type": "string",
      "metadata": {
        "description": "Name of the App Service app."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for resources."
      }
    },
    "appServicePlanName": {
      "type": "string",
      "defaultValue": "[format('{0}-plan', parameters('appName'))]",
      "metadata": {
        "description": "App Service plan name."
      }
    },
    "appServiceSku": {
      "type": "string",
      "defaultValue": "P1v3",
      "metadata": {
        "description": "App Service plan SKU."
      }
    },
    "appServiceSubnetResourceId": {
      "type": "string",
      "metadata": {
        "description": "Existing delegated subnet resource ID for App Service VNet integration."
      }
    },
    "storageAccountName": {
      "type": "string",
      "metadata": {
        "description": "Storage account name used by the blob manager."
      }
    },
    "blobContainerName": {
      "type": "string",
      "metadata": {
        "description": "Blob container name managed by the app."
      }
    },
    "adminAccessKey": {
      "type": "securestring",
      "metadata": {
        "description": "Admin key required to access blob management routes."
      }
    },
    "linuxFxVersion": {
      "type": "string",
      "defaultValue": "NODE|20-lts",
      "metadata": {
        "description": "Runtime stack for Linux web app."
      }
    },
    "sessionCookieName": {
      "type": "string",
      "defaultValue": "blob-manager-admin",
      "metadata": {
        "description": "Session cookie name used by the app."
      }
    },
    "sessionCookieSecure": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Whether secure session cookies are required (recommended true for HTTPS)."
      }
    },
    "corsAllowedOrigins": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Allowed CORS origins for App Service. Use empty array to disable explicit CORS settings."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-01-01",
      "name": "[parameters('appServicePlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('appServiceSku')]",
        "capacity": 1
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-01-01",
      "name": "[parameters('appName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[parameters('linuxFxVersion')]",
          "alwaysOn": true,
          "appSettings": [
            {
              "name": "WEBSITES_PORT",
              "value": "3000"
            },
            {
              "name": "STORAGE_ACCOUNT_NAME",
              "value": "[parameters('storageAccountName')]"
            },
            {
              "name": "BLOB_CONTAINER_NAME",
              "value": "[parameters('blobContainerName')]"
            },
            {
              "name": "ADMIN_ACCESS_KEY",
              "value": "[parameters('adminAccessKey')]"
            },
            {
              "name": "SESSION_COOKIE_NAME",
              "value": "[parameters('sessionCookieName')]"
            },
            {
              "name": "SESSION_COOKIE_SECURE",
              "value": "[string(parameters('sessionCookieSecure'))]"
            }
          ]
        },
        "virtualNetworkSubnetId": "[parameters('appServiceSubnetResourceId')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('appServicePlanName'))]"
      ]
    },
    {
      "condition": "[greater(length(parameters('corsAllowedOrigins')), 0)]",
      "type": "Microsoft.Web/sites/config",
      "apiVersion": "2023-01-01",
      "name": "[format('{0}/{1}', parameters('appName'), 'web')]",
      "properties": {
        "cors": {
          "allowedOrigins": "[parameters('corsAllowedOrigins')]",
          "supportCredentials": true
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
      "name": "[guid(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), resourceId('Microsoft.Web/sites', parameters('appName')), 'storage-blob-data-contributor')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-01-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', 'ba92f5b4-2d11-453d-a403-e96b0029c9fe')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('appName'))]"
      ]
    }
  ],
  "outputs": {
    "webAppName": {
      "type": "string",
      "value": "[parameters('appName')]"
    },
    "webAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('appName')), '2023-01-01', 'full').identity.principalId]"
    }
  }
}